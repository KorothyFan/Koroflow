<?svml using="@hypit/markup@1"?>
<svml>
  <import as="gpt" from="@hypit/gpt-image@1"/>
  <import as="text" from="@hypit/text@1"/>

  <text:Value id="prompt">A clean studio photograph of a blue glass orb on a white pedestal.</text:Value>
  <gpt:Image id="orb" prompt={prompt} aspect-ratio="1:1" resolution="2K"/>
</svml>
