{
  "name": "koroflow",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Reusable video production workflow: quality, platform adapters, revisions, statistics and publishing handoffs",
  "engines": { "node": ">=22.15.0" },
  "scripts": {
    "setup": "node scripts/workflow.mjs setup",
    "install-skill": "node scripts/workflow.mjs install-skill",
    "verify": "node scripts/workflow.mjs verify",
    "bundle": "node scripts/bundle.mjs",
    "test:operations": "python -X utf8 -m unittest discover -s tests -p \"test_*.py\" -v",
    "core": "python -X utf8 scripts/koroflow.py"
  }
}
